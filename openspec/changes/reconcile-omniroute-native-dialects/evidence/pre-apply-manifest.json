{
 "allowed_mode_tightenings": [],
 "apply_safety": {
  "atomic_replacement": "write temp file in same directory, fsync, os.replace, then chmod",
  "backup_dir": "~/.hermes/backups/reconcile-omniroute-native-dialects",
  "backup_dir_mode": "0o700",
  "backup_file_mode": "0o600 (all 12 mutate targets)",
  "claude_code_note": "Claude Code surface owned by archived add-claude-code-omniroute-pm-launcher; no Claude Code files mutated by this change; earlier \"12\" count included the archived change's helper+profile pair, corrected to the 11 overlay targets here.",
  "mutate_target_count": 11,
  "mutate_targets": [
   "~/.cline/data/settings/providers.json",
   "~/.codex/omniroute.config.toml",
   "~/.config/goose/custom_providers/custom_omniroute_anthropic.json",
   "~/.config/kilo/kilo.jsonc",
   "~/.config/opencode/opencode.json",
   "~/.factory/settings.json",
   "~/.grok/config.toml",
   "~/.kimi-code/config.toml",
   "~/.omp/agent/models.yml",
   "~/.pi/agent/models.json",
   "~/.prime/agent/models.json"
  ],
  "one_file_at_a_time": true,
  "single_writer": "root agent session 01a04bcc (reconcile apply owner)",
  "verify_after_write": "parse validation + live sentinel per file; rollback on any failure"
 },
 "changed_paths": [],
 "default_preservation_contract": {
  "default_probe_runner": "task 5.4 executor: evidence/default-probe-runner.py (to be provided at apply time; rows from default-probe-matrix.json are executed with cwd /tmp, no override flags, value-blind capture; schema mapping: working_directory->cwd, expected->exact sentinel, timeout->per-row bound)",
  "evidence_output": "evidence/post-apply-manifest.json + evidence/default-probe-results.json",
  "post_check": [
   "1. every defaults.* key value equals its pre-apply value (no default drift)",
   "2. every existing file keeps its pre-apply sha256 UNLESS it is one of the 12 apply targets",
   "3. non-target files: mode + sha256 identical to pre-apply manifest",
   "4. apply targets: parse-valid JSON/TOML/YAML/JSONC after merge; unrelated top-level keys preserved",
   "5. new files: created with expected_new_file_modes (0600)",
   "6. explicit-route sentinels recorded separately from no-override default probes (default-probe-matrix.json)",
   "7. any failure: atomic restore from backup, target reported blocked/unchanged"
  ],
  "pre_snapshot": "files{sha256,mode} + defaults{} + default_selector_hashes{} (this manifest)"
 },
