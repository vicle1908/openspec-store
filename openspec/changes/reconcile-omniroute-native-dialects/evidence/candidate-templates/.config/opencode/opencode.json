{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute-responses": {
      "npm": "@ai-sdk/openai",
      "name": "OmniRoute Responses",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "sh/gpt-5.6-sol": {
          "name": "sh/gpt-5.6-sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto"
          }
        }
      }
    },
    "omniroute-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "OmniRoute Anthropic",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "pm/Claude-Fable": {
          "name": "pm/Claude-Fable",
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        }
      }
    }
  }
}
