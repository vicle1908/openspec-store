{
  "$schema": "./workstation-manifest.schema.json",
  "version": "1.0.0",
  "schema_version": "2020-12",
  "description": "Canonical declarative toolchain ownership manifest for macOS development workstation",
  "sanctioned_roots": [
    "~/.npm-global",
    "~/.bun",
    "~/.local/share/home-toolchain",
    "/opt/homebrew",
    "~/.local/share",
    "~/.local/bin"
  ],
  "protected_volumes": [
    "omniroute_data"
  ],
  "profiles": {
    "core": [
      "git",
      "node",
      "npm",
      "pnpm",
      "bun",
      "uv",
      "claude",
      "codex",
      "qoder",
      "gitnexus",
      "openspec"
    ],
    "ai-agents": [
      "claude",
      "codex",
      "qoder",
      "qodercli",
      "gitnexus",
      "opencode",
      "goose",
      "grok",
      "droid",
      "cursor-agent",
      "hermes-agent",
      "buzz",
      "kilo",
      "auggie",
      "happy",
      "cce",
      "pi",
      "prime-agent",
      "muse",
      "kimi",
      "qwen",
      "orca",
      "herdr",
      "omp"
    ],
    "isolated-toolchain": [
      "newman",
      "bru"
    ],
    "python-dev": [
      "uv",
      "ruff",
      "pytest"
    ],
    "db-tools": [
      "psql",
      "redis-cli"
    ],
    "rust-dev": [
      "rustup",
      "cargo"
    ]
  },
  "tools": {
    "git": {
      "authoritative_owner": "brew-formula",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/git",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "git --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade git",
      "delegating_to": null,
      "package_name": "git",
      "category": "vcs",
      "notes": "Homebrew Git."
    },
    "node": {
      "authoritative_owner": "brew-formula",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/node",
