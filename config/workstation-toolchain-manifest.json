{
  "$schema": "./workstation-manifest.schema.json",
  "version": "1.0.0",
  "schema_version": "2020-12",
  "description": "Canonical declarative toolchain ownership manifest for macOS development workstation",
  "sanctioned_roots": [
    "~/.npm-global",
    "~/.local/share/home-toolchain",
    "/opt/homebrew",
    "~/.local/share",
    "~/.local/bin"
  ],
  "protected_volumes": [
    "omniroute_data"
  ],
  "profiles": {
    "core": [
      "git",
      "node",
      "uv",
      "claude",
      "codex",
      "qoder",
      "gitnexus"
    ],
    "ai-agents": [
      "claude",
      "codex",
      "qoder",
      "qodercli",
      "gitnexus",
      "opencode",
      "goose",
      "grok",
      "droid",
      "cursor-agent",
      "hermes-agent",
      "buzz",
      "kilo",
      "auggie",
      "happy",
      "cce",
      "pi",
      "prime-agent"
    ],
    "isolated-toolchain": [
      "newman",
      "bru"
    ],
    "python-dev": [
      "uv",
      "ruff",
      "pytest"
    ],
    "db-tools": [
      "psql",
      "redis-cli"
    ],
    "rust-dev": [
      "rustup",
      "cargo"
    ]
  },
  "tools": {
    "git": {
      "authoritative_owner": "brew-formula",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/git",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "git --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade git",
      "delegating_to": null,
      "package_name": "git",
      "category": "vcs",
      "notes": "Homebrew Git."
    },
    "node": {
      "authoritative_owner": "brew-formula",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/node",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "node --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade node",
      "delegating_to": null,
      "package_name": "node",
      "category": "runtime",
      "notes": "Node.js JavaScript runtime."
    },
    "uv": {
      "authoritative_owner": "brew-formula",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/uv",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "uv --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade uv",
      "delegating_to": null,
      "package_name": "uv",
      "category": "package-manager",
      "notes": "Astral uv fast Python package installer and resolver."
    },
    "claude": {
      "authoritative_owner": "standalone",
      "active_path_pattern": "{{HOME}}/.local/bin/claude",
      "update_authority": "vendor-download",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "claude --version",
      "writer_binary": "claude",
      "supported_verb": "claude update",
      "delegating_to": null,
      "package_name": null,
      "known_shadow_paths": [
        "{{HOME}}/.npm-global/bin/claude",
        "{{HOMEBREW_PREFIX}}/bin/claude"
      ],
      "category": "ai-agent",
      "notes": "Official native standalone installer with auto-update."
    },
    "codex": {
      "authoritative_owner": "npm-global",
      "active_path_pattern": "{{HOME}}/.npm-global/bin/codex",
      "update_authority": "npm-global",
      "release_channel": "latest",
      "dispatch_classification": "none",
      "verification_smoke_command": "codex --version",
      "writer_binary": "npm",
      "supported_verb": "npm --prefix {{HOME}}/.npm-global install --global @openai/codex",
      "delegating_to": null,
      "package_name": "@openai/codex",
      "known_shadow_paths": [
        "{{HOME}}/.local/bin/codex"
      ],
      "category": "ai-agent",
      "notes": "Authoritative owner is npm-global under ~/.npm-global. No documented native CLI update verb; npm binaries refuse self-update."
    },
    "qoder": {
      "authoritative_owner": "standalone",
      "active_path_pattern": "{{HOME}}/.local/bin/qodercli",
      "update_authority": "vendor-download",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "qoder --version",
      "writer_binary": "qoder",
      "supported_verb": "qoder update",
      "delegating_to": null,
      "package_name": null,
      "known_shadow_paths": [
        "{{HOME}}/.npm-global/bin/qodercli"
      ],
      "category": "ai-agent",
      "notes": "Standalone vendor dispatcher ~/.qoder/entry is authoritative. Shadowing npm package @qoder-ai/qodercli staged for removal."
    },
    "qodercli": {
      "authoritative_owner": "standalone",
      "active_path_pattern": "{{HOME}}/.local/bin/qodercli",
      "update_authority": "vendor-download",
      "release_channel": "stable",
      "dispatch_classification": "delegating",
      "verification_smoke_command": "qodercli --version",
      "writer_binary": "qoder",
      "supported_verb": "qoder update",
      "delegating_to": "qoder",
      "package_name": null,
      "category": "ai-agent",
      "notes": "Delegates to standalone qoder entry."
    },
    "gitnexus": {
      "authoritative_owner": "npm-global",
      "active_path_pattern": "{{HOME}}/.npm-global/bin/gitnexus",
      "update_authority": "npm-global",
      "release_channel": "latest",
      "dispatch_classification": "none",
      "verification_smoke_command": "gitnexus --version",
      "writer_binary": "npm",
      "supported_verb": "npm --prefix {{HOME}}/.npm-global install --global gitnexus",
      "delegating_to": null,
      "package_name": "gitnexus",
      "known_shadow_paths": [
        "{{HOME}}/.local/share/home-toolchain/bin/gitnexus"
      ],
      "category": "code-intelligence",
      "notes": "Official distribution is npm-global. Migrating from isolated toolchain after native binding verification and MCP smoke test."
    },
    "newman": {
      "authoritative_owner": "isolated-node",
      "active_path_pattern": "{{HOME}}/.local/share/home-toolchain/bin/newman",
      "update_authority": "isolated-node",
      "release_channel": "pinned-6.2.2",
      "dispatch_classification": "none",
      "verification_smoke_command": "newman --version",
      "writer_binary": "npm",
      "supported_verb": null,
      "delegating_to": null,
      "package_name": "newman",
      "known_shadow_paths": [
        "{{HOMEBREW_PREFIX}}/bin/newman"
      ],
      "category": "testing",
      "notes": "Retained in isolated toolchain pinned to 6.2.2 with newman-reporter-htmlextra for Postman collection execution and Faker v5 compatibility."
    },
    "bru": {
      "authoritative_owner": "isolated-node",
      "active_path_pattern": "{{HOME}}/.local/share/home-toolchain/bin/bru",
      "update_authority": "isolated-node",
      "release_channel": "latest",
      "dispatch_classification": "none",
      "verification_smoke_command": "bru --version",
      "writer_binary": "npm",
      "supported_verb": "npm --prefix {{HOME}}/.local/share/home-toolchain install --global @usebruno/cli",
      "delegating_to": null,
      "package_name": "@usebruno/cli",
      "category": "testing",
      "notes": "Bruno CLI in isolated toolchain. Targeted upgrade candidate from 4.2.0 to 4.2.1."
    },
    "opencode": {
      "authoritative_owner": "brew-formula",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/opencode",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "opencode --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade opencode",
      "delegating_to": null,
      "package_name": "anomalyco/tap/opencode",
      "known_shadow_paths": [
        "{{HOME}}/.npm-global/bin/opencode"
      ],
      "category": "ai-agent",
      "notes": "Formula is active and maintained. npm package is duplicate install staged for removal."
    },
    "goose": {
      "authoritative_owner": "brew-formula",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/goose",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "goose --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade block-goose-cli",
      "delegating_to": null,
      "package_name": "block-goose-cli",
      "category": "ai-agent",
      "notes": "Homebrew formula block-goose-cli."
    },
    "hermes-agent": {
      "authoritative_owner": "brew-formula",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/hermes",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "hermes --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade hermes-agent",
      "delegating_to": null,
      "package_name": "hermes-agent",
      "category": "ai-agent",
      "notes": "Homebrew formula hermes-agent."
    },
    "grok": {
      "authoritative_owner": "brew-cask",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/grok",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "grok --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade --cask grok-build",
      "delegating_to": null,
      "package_name": "grok-build",
      "category": "ai-agent",
      "notes": "Homebrew cask grok-build. Distinguish from unrelated formula grok."
    },
    "droid": {
      "authoritative_owner": "brew-cask",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/droid",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "droid --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade --cask droid",
      "delegating_to": null,
      "package_name": "droid",
      "category": "ai-agent",
      "notes": "Homebrew cask droid."
    },
    "cursor-agent": {
      "authoritative_owner": "brew-cask",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/cursor-agent",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "cursor-agent --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade --cask cursor-cli",
      "delegating_to": null,
      "package_name": "cursor-cli",
      "category": "ai-agent",
      "notes": "Homebrew cask cursor-cli."
    },
    "buzz": {
      "authoritative_owner": "brew-cask",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/buzz",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "buzz --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade --cask buzz",
      "delegating_to": null,
      "package_name": "buzz",
      "category": "ai-agent",
      "notes": "Homebrew cask buzz."
    },
    "kilo": {
      "authoritative_owner": "npm-global",
      "active_path_pattern": "{{HOME}}/.npm-global/bin/kilo",
      "update_authority": "npm-global",
      "release_channel": "latest",
      "dispatch_classification": "none",
      "verification_smoke_command": "kilo --version",
      "writer_binary": "npm",
      "supported_verb": "npm --prefix {{HOME}}/.npm-global install --global @kilocode/cli",
      "delegating_to": null,
      "package_name": "@kilocode/cli",
      "category": "ai-agent",
      "notes": "npm package @kilocode/cli."
    },
    "auggie": {
      "authoritative_owner": "npm-global",
      "active_path_pattern": "{{HOME}}/.npm-global/bin/auggie",
      "update_authority": "npm-global",
      "release_channel": "latest",
      "dispatch_classification": "none",
      "verification_smoke_command": "auggie --version",
      "writer_binary": "npm",
      "supported_verb": "npm --prefix {{HOME}}/.npm-global install --global @augmentcode/auggie",
      "delegating_to": null,
      "package_name": "@augmentcode/auggie",
      "category": "ai-agent",
      "notes": "npm package @augmentcode/auggie."
    },
    "happy": {
      "authoritative_owner": "npm-global",
      "active_path_pattern": "{{HOME}}/.npm-global/bin/happy",
      "update_authority": "npm-global",
      "release_channel": "latest",
      "dispatch_classification": "none",
      "verification_smoke_command": "happy --version",
      "writer_binary": "npm",
      "supported_verb": "npm --prefix {{HOME}}/.npm-global install --global happy",
      "delegating_to": null,
      "package_name": "happy",
      "category": "ai-agent",
      "notes": "npm package happy."
    },
    "cce": {
      "authoritative_owner": "standalone",
      "active_path_pattern": "{{HOME}}/.local/bin/cce",
      "update_authority": "none",
      "release_channel": "pinned",
      "dispatch_classification": "none",
      "verification_smoke_command": "cce --version",
      "writer_binary": null,
      "supported_verb": null,
      "delegating_to": null,
      "package_name": null,
      "category": "ai-agent",
      "notes": "Local binary wrapper for Claude Code Ecosystem."
    },
    "pi": {
      "authoritative_owner": "standalone",
      "active_path_pattern": "{{HOME}}/.pi/agent/bin/pi",
      "update_authority": "vendor-download",
      "release_channel": "managed",
      "dispatch_classification": "native",
      "verification_smoke_command": "pi --version",
      "writer_binary": "pi",
      "supported_verb": "pi update",
      "delegating_to": null,
      "package_name": null,
      "category": "ai-agent",
      "notes": "Pi managed runtime at ~/.pi/agent/bin/pi."
    },
    "prime-agent": {
      "authoritative_owner": "local-dev",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/lib/node_modules/prime-agent",
      "update_authority": "manual",
      "release_channel": "local-custom",
      "dispatch_classification": "none",
      "verification_smoke_command": "prime-agent --version",
      "writer_binary": null,
      "supported_verb": null,
      "delegating_to": null,
      "package_name": "prime-agent",
      "category": "ai-agent",
      "notes": "Local TypeScript build symlinked to Homebrew lib. Excluded from automated updates due to upstream Rust divergence."
    },
    "ruff": {
      "authoritative_owner": "uv",
      "active_path_pattern": "{{HOME}}/.local/bin/ruff",
      "update_authority": "uv",
      "release_channel": "latest",
      "dispatch_classification": "native",
      "verification_smoke_command": "ruff --version",
      "writer_binary": "uv",
      "supported_verb": "uv tool upgrade ruff",
      "delegating_to": null,
      "package_name": "ruff",
      "category": "linter",
      "notes": "Fast Python linter and formatter installed via uv tool."
    },
    "pytest": {
      "authoritative_owner": "uv",
      "active_path_pattern": "{{HOME}}/.local/bin/pytest",
      "update_authority": "uv",
      "release_channel": "latest",
      "dispatch_classification": "native",
      "verification_smoke_command": "pytest --version",
      "writer_binary": "uv",
      "supported_verb": "uv tool upgrade pytest",
      "delegating_to": null,
      "package_name": "pytest",
      "category": "testing",
      "notes": "Python test runner installed via uv tool."
    },
    "psql": {
      "authoritative_owner": "brew-formula",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/psql",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "psql --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade libpq",
      "delegating_to": null,
      "package_name": "libpq",
      "category": "database",
      "notes": "PostgreSQL client CLI (profile: db-tools)."
    },
    "redis-cli": {
      "authoritative_owner": "brew-formula",
      "active_path_pattern": "{{HOMEBREW_PREFIX}}/bin/redis-cli",
      "update_authority": "brew",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "redis-cli --version",
      "writer_binary": "brew",
      "supported_verb": "brew upgrade redis",
      "delegating_to": null,
      "package_name": "redis",
      "category": "database",
      "notes": "Redis client CLI (profile: db-tools)."
    },
    "rustup": {
      "authoritative_owner": "standalone",
      "active_path_pattern": "{{HOME}}/.cargo/bin/rustup",
      "update_authority": "vendor-download",
      "release_channel": "stable",
      "dispatch_classification": "native",
      "verification_smoke_command": "rustup --version",
      "writer_binary": "rustup",
      "supported_verb": "rustup update",
      "delegating_to": null,
      "package_name": null,
      "category": "rust",
      "notes": "Rust toolchain installer (profile: rust-dev)."
    },
    "cargo": {
      "authoritative_owner": "standalone",
      "active_path_pattern": "{{HOME}}/.cargo/bin/cargo",
      "update_authority": "vendor-download",
      "release_channel": "stable",
      "dispatch_classification": "delegating",
      "verification_smoke_command": "cargo --version",
      "writer_binary": "rustup",
      "supported_verb": "rustup update",
      "delegating_to": "rustup",
      "package_name": null,
      "category": "rust",
      "notes": "Rust package manager (profile: rust-dev)."
    }
  }
}
