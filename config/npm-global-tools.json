{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "profile": "npm-global-tools",
  "description": "Sanctioned globally installed npm tools managed under ~/.npm-global prefix",
  "tools": [
    {
      "name": "openspec",
      "package": "@fission-ai/openspec",
      "version": "latest",
      "description": "OpenSpec CLI"
    },
    {
      "name": "gitnexus",
      "package": "gitnexus",
      "version": "latest",
      "description": "GitNexus code intelligence CLI"
    },
    {
      "name": "kilo",
      "package": "@kilocode/cli",
      "version": "latest",
      "description": "Kilo Code CLI"
    },
    {
      "name": "auggie",
      "package": "@augmentcode/auggie",
      "version": "latest",
      "description": "Augment Code CLI"
    },
    {
      "name": "happy",
      "package": "happy",
      "version": "latest",
      "description": "Happy CLI"
    }
  ]
}
