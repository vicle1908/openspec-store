{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "profile": "uv-tools",
  "description": "Sanctioned CLI tools installed and isolated via uv tool",
  "tools": [
    {
      "name": "graphifyy",
      "package": "graphifyy",
      "version": "latest",
      "description": "Graphify knowledge graph CLI"
    },
    {
      "name": "tavily-cli",
      "package": "tavily-cli",
      "version": "latest",
      "description": "Tavily search CLI"
    },
    {
      "name": "browser-use",
      "package": "browser-use @ git+https://github.com/browser-use/browser-use.git",
      "version": "latest",
      "description": "Browser Use CLI and Cloud V4 agent/browser harness"
    }
  ]
}
