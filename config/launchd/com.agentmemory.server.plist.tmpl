<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentmemory.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{HOMEBREW_PREFIX}}/bin/node</string>
        <string>{{HOME}}/.npm-global/bin/agentmemory</string>
        <string>server</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{HOME}}/.local/bin:{{HOMEBREW_PREFIX}}/bin:{{HOME}}/.npm-global/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/agentmemory-server.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/agentmemory-server.stderr.log</string>
</dict>
</plist>
